{
  "name": "travelbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "TravelBuddy — AI-Powered Tourism Recommendation & Travel Planning Web Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"python backend/run.py\" \"npm --prefix frontend run dev\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"python backend/run.py\" \"npm --prefix frontend run dev\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "python backend/run.py",
    "seed": "python backend/seed_database.py",
    "test": "python -m unittest discover backend/tests",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install:frontend": "npm --prefix frontend install"
  },
  "keywords": [
    "travel",
    "react",
    "vite",
    "tailwind",
    "ai-tourism",
    "flask",
    "sqlalchemy",
    "scikit-learn"
  ],
  "author": "Amrit Pradhan",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
