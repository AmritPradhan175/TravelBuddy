# TravelBuddy REST API Environment Configuration
FLASK_ENV=development
SECRET_KEY=travelbuddy-super-secret-development-key-2026

# Database Connection (Default SQLite or local/managed PostgreSQL)
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/travelbuddy
# For Render/Supabase: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///travelbuddy.db

# Server Host & Port
PORT=5000
HOST=127.0.0.1

# Permitted CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Auth Configuration
TOKEN_EXPIRATION_HOURS=72
